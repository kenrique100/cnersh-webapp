# Database - PostgreSQL connection strings
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_URL="https://your-domain.com"
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://your-domain.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (for sending emails)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@your-domain.com"

# UploadThing
UPLOADTHING_SECRET="sk_live_your_uploadthing_secret"
UPLOADTHING_APP_ID="your_uploadthing_app_id"

# Admin User (REQUIRED for seeding)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="System Admin"

# Super Admin User (REQUIRED for seeding)
SUPER_ADMIN_EMAIL="superadmin@your-domain.com"
SUPER_ADMIN_PASSWORD="ChangeMeSuper123!"
SUPER_ADMIN_NAME="Super Admin"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn-here@o123456.ingest.sentry.io/123456"
SENTRY_PROJECT="your-project-name"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Public app URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Cron secret
CRON_SECRET="your-cron-secret-here"