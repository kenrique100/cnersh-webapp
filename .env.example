# Database - PostgreSQL connection strings
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_URL="https://your-domain.com"
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://your-domain.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (for sending emails)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@your-domain.com"

# UploadThing v6 server secret
UPLOADTHING_SECRET="sk_your-uploadthing-secret"

# Shared Redis (required in production for rate limits and idempotency)
REDIS_URL="redis://default:password@your-redis-host:6379"

# Admin User (REQUIRED for seeding)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="System Admin"

# Super Admin User (REQUIRED for seeding)
SUPER_ADMIN_EMAIL="superadmin@your-domain.com"
SUPER_ADMIN_PASSWORD="ChangeMeSuper123!"
SUPER_ADMIN_NAME="Super Admin"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn-here@o123456.ingest.sentry.io/123456"
SENTRY_PROJECT="your-project-name"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Public app URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Cron secret
CRON_SECRET="your-cron-secret-here"

# Account deletion / cryptographic erasure (see docs/ACCOUNT_DELETION.md)
# Key-encryption key that wraps every user's data key. 32 random bytes, base64:
#   openssl rand -base64 32
# Losing this key makes ALL sealed data unreadable. Store it in the secret manager only.
ERASURE_KEK=""
ERASURE_KEK_ID="kek-1"
# Comma-separated "<id>:<base64>" pairs kept readable during rotation (npm run erasure:rotate-kek)
ERASURE_KEK_PREVIOUS=""
# Separate PostgreSQL database for per-user keys and the deletion journal.
# It MUST NOT be part of the application database's backup set; otherwise a
# restore would bring destroyed keys back. Apply scripts/sql/erasure-store.sql to it.
ERASURE_STORE_URL="postgresql://user:password@host:5432/cnersh_erasure?sslmode=require"
# Optional 32-byte base64 key used to pseudonymise emails in the deletion journal
ERASURE_HMAC_KEY=""
