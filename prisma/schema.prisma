generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  role                String?
  bio                 String?
  hasDeletePermission Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  emailVerified       Boolean   @default(false)
  welcomeEmailSent    Boolean   @default(false)
  image               String?
  gender              Gender?
  profession          String?
  title               String?
  banned              Boolean?
  banReason           String?
  banExpires          DateTime?
  expertiseTags       String[]  @default([])
  pendingActivation   Boolean   @default(false)
  activationExpiresAt DateTime?
  deletionRequestedAt DateTime?
  erasedAt            DateTime?

  sessions            Session[]
  accounts            Account[]
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  projects            Project[]            @relation("ProjectOwner")
  assignedProjects    Project[]            @relation("ProjectReviewer")
  communityTopics     CommunityTopic[]
  communityReplies    CommunityReply[]
  reports             Report[]             @relation("ReportAuthor")
  notifications       Notification[]
  auditLogs           AuditLog[]
  commentLikes        CommentLike[]
  communityTopicLikes CommunityTopicLike[]
  reviewAssignments   ReviewAssignment[]
  coiDeclarations     COIDeclaration[]
  evaluationReports   EvaluationReport[]
  saeReports          SAEReport[]
  aarApplications     AARApplication[]
  appeals             Appeal[]
  files               File[]
  deletionRequests    AccountDeletionRequest[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([erasedAt])
  @@map("user")
}

/// Lifecycle of an account deletion. Transitions are owned by
/// src/lib/erasure/deletion-service.ts and are idempotent so a request can be
/// resumed after a crash, a failed external call, or a database restore.
enum AccountDeletionStatus {
  REQUESTED
  ACCEPTED
  PROCESSING
  BLOCKED
  COMPLETED

  @@map("account_deletion_status")
}

model AccountDeletionRequest {
  id             String                @id @default(uuid())
  status         AccountDeletionStatus @default(REQUESTED)
  requestedVia   String
  requestedById  String
  reason         String?
  attempts       Int                   @default(0)
  lastError      String?
  lastAttemptAt  DateTime?
  completedSteps String[]              @default([])
  journalId      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  completedAt    DateTime?
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("account_deletion_request")
}

/// Per-subject data-encryption key, wrapped by the configured KEK.
/// Lives in the erasure store (ERASURE_STORE_URL). When that store is the
/// application database this table is created by the Prisma migration; when it
/// is a separate database, scripts/sql/erasure-store.sql creates it there.
model ErasureSubjectKey {
  subjectId  String    @id
  keyVersion Int       @default(1)
  kekId      String
  wrappedDek Bytes
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime?

  @@map("erasure_subject_key")
}

/// Durable record of every accepted deletion. Never deleted. Used by the
/// restore gate (scripts/reconcile-erasure-journal.ts and the erasure cron) to
/// re-apply deletions that a backup restore would otherwise undo.
model ErasureJournalEntry {
  id               String    @id @default(uuid())
  subjectId        String    @unique
  emailHmac        String?
  status           String
  requestedVia     String
  requestedAt      DateTime  @default(now())
  keyDestroyedAt   DateTime?
  completedAt      DateTime?
  lastReconciledAt DateTime?
  details          Json?
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([emailHmac])
  @@map("erasure_journal")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Gender {
  male
  female

  @@map("gender")
}

enum FileType {
  avatar
  protocol
  document
  image
  video
  audio

  @@map("file_type")
}

model File {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  url       String?
  storageKey String?  @unique
  data      String?
  type      FileType
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@index([createdAt])
  @@map("file")
}

model Post {
  id              String    @id @default(uuid())
  content         String
  image           String?
  video           String?
  images          String[]  @default([])
  videos          String[]  @default([])
  tags            String[]  @default([])
  linkUrl         String?
  linkType        String?
  commentsEnabled Boolean   @default(true)
  deleted         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments        Comment[]
  likes           Like[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([deleted, createdAt])
  @@map("post")
}

model Comment {
  id           String        @id @default(uuid())
  content      String
  deleted      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  postId       String
  userId       String
  parentId     String?
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([postId, deleted, parentId, createdAt])
  @@map("comment")
}

model CommentLike {
  id           String   @id @default(uuid())
  isDislike    Boolean  @default(false)
  reactionType String   @default("Like")
  createdAt    DateTime @default(now())
  commentId    String
  userId       String
  comment      Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_like")
}

model Like {
  id           String   @id @default(uuid())
  reactionType String   @default("Like")
  createdAt    DateTime @default(now())
  postId       String
  userId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([postId, createdAt])
  @@map("like")
}

model Project {
  id                String                 @id @default(uuid())
  trackingCode      String                 @unique
  referenceNumber   String?
  title             String
  description       String
  objectives        String?
  category          String
  location          String?
  timeline          String?
  budget            String?
  document          String?
  formData          Json?
  status            ProjectStatus          @default(DRAFT)
  feedback          String?
  deleted           Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  userId            String
  assignedToId      String?
  user              User                   @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo        User?                  @relation("ProjectReviewer", fields: [assignedToId], references: [id], onDelete: SetNull)
  statusHistory     ProjectStatusHistory[]
  reviewAssignments ReviewAssignment[]
  appeal            Appeal?
  aarApplication    AARApplication?
  saeReports        SAEReport[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([trackingCode])
  @@index([createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([category, status])
  @@map("project")
}

model ProjectStatusHistory {
  id        String        @id @default(uuid())
  status    ProjectStatus
  comment   String?
  changedBy String
  createdAt DateTime      @default(now())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_status_history")
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  RETURNED_INCOMPLETE
  PENDING_REVIEW
  UNDER_REVIEW
  REVIEW_COMPLETE
  SESSION_SCHEDULED
  APPROVED
  APPROVED_WITH_CONDITIONS
  RESUBMIT
  UNDER_APPEAL
  APPEAL_RESOLVED
  ARCHIVED

  @@map("project_status")
}

model CommunityTopic {
  id          String               @id @default(uuid())
  title       String
  content     String
  category    String
  image       String?
  images      String[]             @default([])
  video       String?
  videos      String[]             @default([])
  documents   String[]             @default([])
  linkUrl     String?
  chatEnabled Boolean              @default(true)
  deleted     Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     CommunityReply[]
  likes       CommunityTopicLike[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("community_topic")
}

model CommunityTopicLike {
  id        String         @id @default(uuid())
  isDislike Boolean        @default(false)
  createdAt DateTime       @default(now())
  topicId   String
  userId    String
  topic     CommunityTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([topicId])
  @@index([userId])
  @@map("community_topic_like")
}

model CommunityReply {
  id            String           @id @default(uuid())
  content       String
  image         String?
  images        String[]         @default([])
  video         String?
  videos        String[]         @default([])
  audio         String?
  audios        String[]         @default([])
  voiceNote     String?
  document      String?
  documents     String[]         @default([])
  linkUrl       String?
  pollQuestion  String?
  pollOptions   String[]         @default([])
  pollVotes     Json?
  eventTitle    String?
  eventDate     DateTime?
  eventLocation String?
  deleted       Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  topicId       String
  parentId      String?
  userId        String
  topic         CommunityTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parent        CommunityReply?  @relation("ReplyToReply", fields: [parentId], references: [id])
  children      CommunityReply[] @relation("ReplyToReply")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
  @@index([parentId])
  @@map("community_reply")
}

model Report {
  id          String       @id @default(uuid())
  reason      String
  contentType ReportTarget
  contentId   String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentType, contentId])
  @@map("report")
}

enum ReportTarget {
  POST
  COMMENT
  TOPIC
  REPLY

  @@map("report_target")
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED

  @@map("report_status")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notification")
}

enum NotificationType {
  PROJECT_STATUS
  REVIEW_ASSIGNED
  REVIEW_REASSIGNED
  COMMENT
  LIKE
  MENTION
  SYSTEM
  ANNOUNCEMENT

  @@map("notification_type")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  targetId  String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Page {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Page?      @relation("PageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]     @relation("PageChildren")
  items     PageItem[]

  @@index([name])
  @@index([parentId])
  @@map("page")
}

model PageItem {
  id        String   @id @default(uuid())
  name      String
  url       String?
  fileUrl   String?
  createdAt DateTime @default(now())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_item")
}

model ReviewAssignment {
  id               String                 @id @default(uuid())
  status           ReviewAssignmentStatus @default(PENDING_COI)
  dueDate          DateTime?
  reassignedFromId String?
  reassignedAt     DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  projectId        String
  reviewerId       String
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer         User                   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  coiDeclaration   COIDeclaration?
  evaluationReport EvaluationReport?

  @@unique([projectId, reviewerId])
  @@index([projectId])
  @@index([reviewerId])
  @@map("review_assignment")
}

enum ReviewAssignmentStatus {
  PENDING_COI
  ACTIVE
  EXCLUDED
  COMPLETED

  @@map("review_assignment_status")
}

model COIDeclaration {
  id           String           @id @default(uuid())
  hasCOI       Boolean
  details      String?
  declaredAt   DateTime         @default(now())
  assignmentId String           @unique
  userId       String
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coi_declaration")
}

model EvaluationReport {
  id                                   String                    @id @default(uuid())
  socialValue                          Int?
  scientificValidity                   Int?
  riskBenefitAnalysis                  Int?
  participantSelection                 Int?
  informedConsentProcess               Int?
  confidentialityDataProtection        Int?
  collaborativePartnership             Int?
  socialValueComment                   String?
  scientificValidityComment            String?
  riskBenefitAnalysisComment           String?
  participantSelectionComment          String?
  informedConsentProcessComment        String?
  confidentialityDataProtectionComment String?
  collaborativePartnershipComment      String?
  overallScore                         Float?
  recommendation                       EvaluationRecommendation?
  generalComments                      String?
  additionalCriteria                   Json?
  status                               EvaluationStatus          @default(DRAFT)
  submittedAt                          DateTime?
  createdAt                            DateTime                  @default(now())
  updatedAt                            DateTime                  @updatedAt
  assignmentId                         String                    @unique
  reviewerId                           String
  assignment                           ReviewAssignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer                             User                      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@map("evaluation_report")
}

enum EvaluationRecommendation {
  FAVORABLE
  FAVORABLE_WITH_CONDITIONS
  UNFAVORABLE

  @@map("evaluation_recommendation")
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED

  @@map("evaluation_status")
}

model CommitteeSession {
  id          String        @id @default(uuid())
  sessionType SessionType   @default(ORDINARY)
  sessionDate DateTime
  venue       String?
  agenda      String[]      @default([])
  status      SessionStatus @default(SCHEDULED)
  quorumMet   Boolean?
  minutes     String?
  notes       String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sessionDate])
  @@index([status])
  @@unique([sessionType, sessionDate])
  @@map("committee_session")
}

enum SessionType {
  ORDINARY
  EXTRAORDINARY

  @@map("session_type")
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED

  @@map("session_status")
}

model Appeal {
  id           String       @id @default(uuid())
  grounds      String
  evidence     String?
  status       AppealStatus @default(PENDING)
  decision     String?
  decisionDate DateTime?
  filedAt      DateTime     @default(now())
  deadlineAt   DateTime
  updatedAt    DateTime     @updatedAt
  projectId    String       @unique
  appellantId  String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appellant    User         @relation(fields: [appellantId], references: [id], onDelete: Cascade)

  @@index([appellantId])
  @@map("appeal")
}

enum AppealStatus {
  PENDING
  UPHELD
  REJECTED
  EXPIRED

  @@map("appeal_status")
}

model AARApplication {
  id             String    @id @default(uuid())
  status         AARStatus @default(DRAFT)
  submittedAt    DateTime?
  drosReceivedAt DateTime?
  drosDueDate    DateTime?
  aarRefNumber   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String    @unique
  applicantId    String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicant      User      @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("aar_application")
}

enum AARStatus {
  DRAFT
  SUBMITTED
  RECEIVED_BY_DROS
  CLARIFICATION_REQUESTED
  AUTHORIZED
  INADMISSIBLE

  @@map("aar_status")
}

model SAEReport {
  id               String       @id @default(uuid())
  eventType        SAEEventType
  eventDate        DateTime
  description      String
  immediateActions String?
  isLate           Boolean      @default(false)
  reportedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  projectId        String
  reporterId       String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter         User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([reporterId])
  @@map("sae_report")
}

enum SAEEventType {
  ADVERSE_EVENT
  SERIOUS_ADVERSE_EVENT
  UNEXPECTED_ADVERSE_EVENT
  LIFE_THREATENING
  FATAL

  @@map("sae_event_type")
}
